{
  "name": "@mgpl-diagnostics/pgbouncer-kit",
  "version": "0.1.0",
  "description": "MGPL Diagnostics PgBouncer setup: env-driven pgbouncer.ini, SCRAM/MD5 userlists, auth_query SQL, a docker-compose service, TLS options and a readiness probe. No runtime dependencies.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "github:mgpl-diagnostics/pgbouncer-kit",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mgpl-pgbouncer": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "llms-full.txt"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test.ts",
    "prepare": "tsup",
    "llms": "node scripts/llms-full.mjs @mgpl-diagnostics/pgbouncer-kit README.md AGENTS.md llms.txt package.json src scripts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
